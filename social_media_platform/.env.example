# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# CSRF — include every origin users browse on (localhost AND 127.0.0.1 if both)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OpenAI image generation
OPENAI_API_KEY=sk-your-key-here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
# True = 3 bundled sample images (no OpenAI tokens). False = real OpenAI.
USE_STATIC_AI_IMAGES=False

# Email (forgot / reset password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SocialFlow <your@gmail.com>

# App timezone
TIME_ZONE=Asia/Kolkata

# PostgreSQL
POSTGRES_DB=social_media_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Meta — App credentials only (each user connects their own Page/Instagram via OAuth)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Public HTTPS origin for Instagram image_url (Meta must fetch your media). Not used for OAuth redirect.
PUBLIC_BASE_URL=https://your-public-tunnel.example
# In Meta Developer → Facebook Login → Valid OAuth Redirect URIs, add e.g.:
#   http://localhost:8000/accounts/meta/callback/
#   http://127.0.0.1:8000/accounts/meta/callback/
